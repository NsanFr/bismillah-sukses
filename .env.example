# Discord Bot Token (Dapatkan di https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Opsional: Guild ID (Server ID) agar Slash Command langsung tersinkronisasi instan tanpa menunggu cache global Discord
GUILD_ID=

# Opsional: Channel ID default untuk info lomba dan beasiswa
DEFAULT_LOMBA_CHANNEL_ID=
DEFAULT_BEASISWA_CHANNEL_ID=

# Interval waktu pengecekan data baru (menit)
SCRAPE_INTERVAL_MINUTES=60

# Target akun publik Instagram terkurasi (dipisahkan koma)
TARGET_INSTAGRAM_ACCOUNTS=infolomba,infolombamahasiswa,beasiswa.id
